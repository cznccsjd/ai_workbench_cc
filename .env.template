# AI工作台环境配置模板
# 复制此文件为 .env 并填入实际值

# ==============================================
# 🔴 基础应用配置
# ==============================================
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# ==============================================
# 🐍 数据库配置 (请选择其中一种)
# ==============================================

# 开发环境 - SQLite (推荐用于本地开发和测试)
DATABASE_URL=sqlite:///./ai_workbench.db

# 生产环境 - PostgreSQL (推荐用于生产部署)
# DATABASE_URL=postgresql://username:password@localhost:5432/ai_workbench

# ==============================================
# 🤖 AI服务配置 (必需)
# ==============================================

# Kimi API配置 (Moonshot AI)
# 获取地址: https://platform.moonshot.cn/
KIMI_API_KEY=your-kimi-api-key-here

# OpenAI API配置 (可选备用)
# 获取地址: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here

# ==============================================
# 🌐 服务器配置
# ==============================================
HOST=0.0.0.0
PORT=8000

# ==============================================
# 📨 邮件服务配置 (可选)
# ==============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ==============================================
# 📦 Redis配置 (可选，用于缓存)
# ==============================================
REDIS_URL=redis://localhost:6379

# ==============================================
# 📁 文件上传配置
# ==============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ==============================================
# 🔐 JWT令牌配置
# ==============================================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================
# 📊 日志配置
# ==============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ==============================================
# 🚦 限流配置
# ==============================================
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# ==============================================
# 🎯 开发者提示
# ==============================================
# 1. 将此文件复制为 .env
# 2. 至少填入 KIMI_API_KEY 才能使用AI功能
# 3. 生产环境务必更改 SECRET_KEY 和 ENCRYPTION_KEY
# 4. 数据库URL根据环境选择SQLite或PostgreSQL
# 5. 邮件配置用于用户通知功能（可选）