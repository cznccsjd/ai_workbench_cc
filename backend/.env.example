# AI工作台后端环境配置
# 请复制此文件为 backend/.env 并填入实际配置值

# 🔴 必需配置 - 请务必填写
KIMI_API_KEY=your-kimi-api-key-here
SECRET_KEY=your-super-secret-key-change-this

# 🐍 数据库配置
DATABASE_URL=sqlite:///./ai_workbench.db

# 📊 应用配置
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 🔐 安全配置
ENCRYPTION_KEY=your-32-char-encryption-key-here

# 📧 邮件配置 (可选)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# 📦 其他服务 (可选)
REDIS_URL=redis://localhost:6379

# 📁 文件存储
UPLOAD_DIR=./uploads

# 📝 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log